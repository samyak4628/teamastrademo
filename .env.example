# Supabase Configuration for ResQFood
# Replace these with your actual Project URL and Anon/Publishable Key from https://supabase.com/dashboard/project/_/settings/api

# Vite Environment Variables (client-side access)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Next.js / Compatibility Aliases
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key-here
